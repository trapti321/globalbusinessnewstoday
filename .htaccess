Options -MultiViews
RewriteEngine On

# Permanently redirect direct requests for /index.html to the clean homepage URL.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Permanently redirect legacy article query URLs to the clean article path.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
RewriteRule ^article\.html$ /articles/%1/ [R=301,L,NE,QSD]

# Permanently redirect legacy category query URLs to the clean category path.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^cat=([A-Za-z0-9-]+)$
RewriteRule ^category\.html$ /category/%1/ [R=301,L,NE,QSD]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^category\.html$ /category/all/ [R=301,L]

# Serve the shared static category template at clean, crawlable URLs.
RewriteRule ^category/([A-Za-z0-9-]+)/?$ category.html?cat=$1 [L,QSA]

# Serve the shared static article template at clean, crawlable URLs.
RewriteRule ^articles/([A-Za-z0-9-]+)/?$ article.html?id=$1 [L,QSA]
